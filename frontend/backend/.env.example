# Optional override. Default: 论文/1_find_paper/data
# REBIRTH_DATA_DIR=C:/Users/Administrator/Desktop/rebirth/论文/1_find_paper/data

# ModCon / Responses API
LLM_API_BASE_URL=https://modcon.top
LLM_API_PROTOCOL=responses
LLM_API_KEY_ENV=codex_modcon_api
LLM_MODEL=gpt-6-sol
LLM_REASONING_EFFORT=xhigh
LLM_DISABLE_RESPONSE_STORAGE=true
LLM_RESPONSES_PATH=/responses
LLM_TIMEOUT_SECONDS=240
LLM_MAX_CONTEXT_CHARS=90000

# The API key is read from the existing system/user environment variable
# codex_modcon_api. Do not paste the key into this file.
